general {
    output_format = "i3bar"
    colors = true
    color_bad = "#f7768e"
    color_degraded = "#e0af68"
    color_good = "#9ece6a"
    color_separator = "#565f89"
    interval = 5
}

order += "ipv6"
order += "disk_status"
order += "memory"
order += "cpu_usage"
order += "load"
order += "temperature"
order += "volume"
order += "battery"
order += "wireless _first"
order += "ethernet _first"
order += "run_watch"
order += "tztime local"

memory {
    format = " �内存 %percentage_used "
    thresholds = "0:30:60"
}

cpu_usage {
    format = " CPU %usage "
    thresholds = "0:30:60"
}

load {
    format = "负载 %1min"
    thresholds = "0:0.7:1.0"
}

temperature {
    format = " 🌡%temperature °C"
    thresholds = "0:60:80"
    path = "/sys/class/thermal/thermal_zone0/temp"
}

volume {
    format = " 🔊%volume"
    format_muted = " 🔇"
    device = "default"
}

battery {
    format = " %status %percentage %time"
    format_full = " %status %percentage %time"
    thresholds = "0:30:60"
}

wireless _first {
    format = " 📶 %essid (%signal)"
    format_connected = " 📶 %essid (%signal)"
    format_disconnected = " �❌"
    thresholds = "0:50:80"
}

ethernet _first {
    format = " 🌐 %ip (%speed)"
    format_disconnected = " �❌"
}

run_watch {
    format = " %title"
    pidfile = "/var/run/connman.pid"
}

tztime local {
    format = " %H:%M "
    format_time = " %a %d %b %H:%M"
}
